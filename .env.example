# Optional shared fallback keys used when a user has not added their own in Settings > API key.
# Leave empty to require each user to bring their own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (not used by the UI yet)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored API keys. Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
